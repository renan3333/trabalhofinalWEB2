# Copie para .env e ajuste. Nunca commite o .env.
# Banco PostgreSQL (ex.: Neon): https://neon.tech
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"
# Gere um segredo forte: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="troque-por-um-segredo-longo"
JWT_EXPIRES_IN="1d"
PORT=3000
# Origens permitidas no CORS, separadas por vírgula (use * em desenvolvimento)
CORS_ORIGIN="*"
